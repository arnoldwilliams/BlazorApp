    public void Dispose()
    {
        readAloudController.Changed -= OnReadAloudChanged;
        Audio.ProgressChanged -= OnExportProgress;
        readAloudController.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;

        if (LastExport is not null)
        {
            await Audio.ReleaseAsync(LastExport.Url);
            LastExport = null;
        }

        if (!string.IsNullOrEmpty(DocumentId))
        {
            await Engine.ReleaseDocumentAsync(DocumentId);
        }

        if (documentHostToken is not null && hostEngine is not null)
        {
            await hostEngine.DetachHostAsync(documentHostToken);
            documentHostToken = null;
        }

        if (visibilityToken is not null && visibilityEngine is not null)
        {
            await visibilityEngine.UnobservePagesAsync(visibilityToken);
            visibilityToken = null;
        }

        if (clipboardModule is not null)
        {
            await clipboardModule.DisposeAsync();
            clipboardModule = null;
        }
    }

    private sealed class PageEntry
    {
        public PageEntry(int pageNumber, DocumentPageSize size, bool shouldRender)
        {
            PageNumber = pageNumber;
            Size = size;
            ShouldRender = shouldRender;
        }

        public int PageNumber { get; }

        public DocumentPageSize Size { get; }

        public bool ShouldRender { get; set; }
    }
