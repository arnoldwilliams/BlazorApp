    private async Task ReadSelection()
    {
        try
        {
            clipboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
            var text = await clipboardModule.InvokeAsync<string>("getPdfSelection");
            if (string.IsNullOrWhiteSpace(text))
            {
                StatusMessage = "Select some text in the document first.";
                StatusAlertClass = "info";
                return;
            }

            readAloudController.Options.VoiceName = string.IsNullOrEmpty(SelectedVoiceName) ? null : SelectedVoiceName;
            await readAloudController.ReadTextAsync(text);
        }
        catch (Exception ex)
        {
            StatusMessage = $"Could not read the selection: {ex.Message}";
            StatusAlertClass = "danger";
        }
    }

    private static string DescribeExportVoice(string voice) => voice switch
    {
        "en" => "English",
        "en-us" => "English (US)",
        "de" => "German",
        "es" => "Spanish",
        "fr" => "French",
        _ => voice,
    };

    private void OnExportRateChanged(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var rate))
        {
            ExportRate = Math.Clamp(rate, 0.5, 2.5);
        }
    }

    private void OnExportGapChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var gap))
        {
            ExportGapMs = Math.Clamp(gap, 0, 1000);
        }
    }

    private void OnExportDownloadChanged(ChangeEventArgs args)
        => ExportDownloadAutomatically = args.Value is true;

    private async Task StartExport()
    {
        if (!CanExport)
        {
            return;
        }

        // Stop playback first so the Web Speech engine and the export share no state.
        await readAloudController.StopAsync();

        IsExporting = true;
        ExportProgress.Stage = "loading";
        ExportProgress.Current = 0;
        ExportProgress.Total = ReadAloud.TotalChunks;
        ExportProgress.Message = string.Empty;
        StatusMessage = string.Empty;

        if (LastExport is not null)
        {
            await Audio.ReleaseAsync(LastExport.Url);
            LastExport = null;
        }

        try
        {
            var passages = GetPassagesToExport();
            if (passages.Count == 0)
            {
                StatusMessage = "There is no text to export for the current selection.";
                StatusAlertClass = "warning";
                return;
            }

            var extension = ExportFormat == AudioFormat.Wav ? "wav" : "mp3";
            var baseName = string.IsNullOrWhiteSpace(DocumentName)
                ? "reading"
                : Path.GetFileNameWithoutExtension(DocumentName);
            var fileName = $"{baseName}.{extension}";

            var options = new AudioExportOptions
            {
                Format = ExportFormat,
                Voice = ExportVoice,
                Rate = ExportRate,
                Pitch = 1.0,
                Volume = 1.0,
                Bitrate = ExportBitrate,
                GapMs = ExportGapMs,
                FileName = fileName,
            };

            var result = await Audio.ExportAsync(passages, options);
            result.FileName = fileName;
            LastExport = result;

            StatusMessage = $"Saved {fileName} ({FormatSize(result.Bytes)}, about {FormatDuration(result.Seconds)}).";
            StatusAlertClass = "success";

            if (ExportDownloadAutomatically)
            {
                await Audio.DownloadAsync(result.Url, result.FileName);
            }
        }
        catch (Exception ex)
        {
            var message = ex.Message;
            if (message.Contains("cancelled", StringComparison.OrdinalIgnoreCase))
            {
                StatusMessage = "Export cancelled.";
                StatusAlertClass = "info";
            }
            else
            {
                StatusMessage = $"Could not save audio: {message}";
                StatusAlertClass = "danger";
            }
        }
        finally
        {
            IsExporting = false;
            StateHasChanged();
        }
    }

    /// <summary>Passages covered by the current export scope, falling back to the whole document.</summary>
    private List<string> GetPassagesToExport()
    {
        var chunks = ReadAloud.Chunks;

        if (ExportScope == AudioExportScope.CurrentPage)
        {
            var pageChunks = chunks.Where(c => c.PageNumber == CurrentPage).ToList();
            if (pageChunks.Count > 0)
            {
                return pageChunks.Select(c => c.Text).ToList();
            }
        }

        return chunks.Select(c => c.Text).ToList();
    }

    private async Task CancelExport()
    {
        await Audio.CancelAsync();
    }

    private async Task DownloadLastExport()
    {
        if (LastExport is not null)
        {
            await Audio.DownloadAsync(LastExport.Url, LastExport.FileName);
        }
    }

    private static string FormatDuration(double seconds)
    {
        var duration = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}h {duration.Minutes}m"
            : duration.TotalMinutes >= 1
                ? $"{(int)duration.TotalMinutes}m {duration.Seconds}s"
                : $"{Math.Max(1, duration.Seconds)}s";
    }

    private Task OnExportProgress(AudioExportProgress progress)
    {
        return InvokeAsync(() =>
        {
            if (isDisposed)
            {
                return;
            }

            ExportProgress.Stage = progress.Stage;
            ExportProgress.Current = progress.Current;
            ExportProgress.Total = progress.Total;
            ExportProgress.Message = progress.Message;
            StateHasChanged();
        });
    }

    private async Task RefreshCurrentPageTextAsync()
    {
        if (!DocumentLoaded || string.IsNullOrEmpty(DocumentId))
        {
            CurrentPageText = null;
            return;
        }

        var pageText = await Engine.GetPageTextAsync(DocumentId, CurrentPage);
        CurrentPageText = pageText?.Text ?? string.Empty;
    }

    private Task OnReadAloudChanged()
    {
        return InvokeAsync(() =>
        {
            if (isDisposed)
            {
                return;
            }

            if (FollowAloud && ReadAloud.CurrentChunk is { } chunk && chunk.PageNumber != CurrentPage)
            {
                CurrentPage = chunk.PageNumber;
                _ = RefreshCurrentPageTextAsync();
            }

            StateHasChanged();
        });
    }

    private IReadOnlyList<PageTextSpanRange>? GetSpanOffsets(int pageNumber)
        => readAloudController.GetSpanOffsetsForPage(pageNumber);

    private PageHighlight? GetHighlight(int pageNumber)
    {
        if (ReadAloud.Status is not (ReadAloudStatus.Speaking or ReadAloudStatus.Paused))
        {
            return null;
        }

        if (ReadAloud.CurrentChunk is not { } chunk || chunk.PageNumber != pageNumber)
        {
            return null;
        }

        return new PageHighlight(pageNumber, chunk.Start, chunk.Length);
    }

    private static string FormatSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double value = bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {units[unit]}";
    }

    // IDocumentTextHost: a span in the text layer was clicked, so start reading from there.
    [JSInvokable]
    public async Task OnTextSpanClickAsync(int pageNumber, int spanNumber)
    {
        await InvokeAsync(async () =>
        {
            if (spanNumber < 0 || !ReadAloud.IsReady)
            {
                return;
            }

            await readAloudController.StartReadingAtSpanAsync(pageNumber, spanNumber);

            if (ReadAloud.Status is not (ReadAloudStatus.Speaking or ReadAloudStatus.Paused))
            {
                StatusMessage = "Could not locate that passage in the extracted text.";
                StatusAlertClass = "info";
            }
        });
    }

    // IDocumentPageVisibilityHost
    public Task OnPageVisibleAsync(int pageNumber)
    {
        var index = pageNumber - 1;
        if (index < 0 || index >= pages.Count)
        {
            return Task.CompletedTask;
        }

        var entry = pages[index];
        if (pageNumber == CurrentPage && !entry.ShouldRender)
        {
            entry.ShouldRender = true;
            needsVisibilityRefresh = true;
            StateHasChanged();
            return Task.CompletedTask;
        }

        if (entry.ShouldRender)
        {
            return Task.CompletedTask;
        }

        entry.ShouldRender = true;
        needsVisibilityRefresh = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // IReadAloudHost
    public async Task EnsurePageVisibleAsync(int pageNumber, CancellationToken cancellationToken)
    {
        await InvokeAsync(async () =>
        {
            if (CurrentPage != pageNumber)
            {
                CurrentPage = pageNumber;
                await RefreshCurrentPageTextAsync();
            }

            var index = pageNumber - 1;
            if (index >= 0 && index < pages.Count)
            {
                pages[index].ShouldRender = true;
            }

            needsVisibilityRefresh = true;
            StateHasChanged();

            if (IsContinuous)
            {
                await Engine.ScrollToPageAsync(viewportRef, pageNumber);
            }
        });
    }

