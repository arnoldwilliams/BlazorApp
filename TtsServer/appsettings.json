{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Piper": {
    "Root": "engines/piper",
    "MaxConcurrency": 2,
    "MaxTextLength": 20000,
    "TimeoutSeconds": 120
  },
  "Cors": {
    "Origins": [ "http://localhost:12000" ]
  }
}
